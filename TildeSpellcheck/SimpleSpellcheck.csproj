<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.1</Version>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildProjectDirectory)\..\build\SimpleSpellcheck</OutputPath>
  </PropertyGroup>

  <!--
    The spellchecker's dictionaries in Hunspell's affix format, shipped so it works the same everywhere.
    en_US is SCOWL's, with COPYRIGHT-SCOWL.txt beside it as its license asks
    en_GB is David Bartlett, Andrew Brown and Marco A.G. Pinto's, under the LGPL 2.1, less en_US's words.
    Its notice is in en_GB.aff, and its license is COPYING-LGPL-2.1.txt
  -->
  <ItemGroup>
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <Content Include="Dictionaries\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Definitions from Wiktionary, synonyms from Open English WordNet and Wiktionary
    Read from disk only when looked up. Their notices ship alongside them.
  -->
  <ItemGroup>
    <Content Include="Lexicon\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <Author>Tildemancer</Author>
    <Name>Simple Spellcheck</Name>
    <Punchline>Spellcheck for the chat box.</Punchline>
    <Description>Underlines misspellings in the chat box, with corrections on right-click. It knows the game's words. Right-click any word to define it or find its synonyms.</Description>
    <Tags>Social;Utility;Roleplay</Tags>
    <IconUrl>https://raw.githubusercontent.com/Tildemancer/SimpleSpellcheck/master/images/icon.png</IconUrl>
  </PropertyGroup>

</Project>
